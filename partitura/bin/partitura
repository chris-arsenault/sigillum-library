#!/usr/bin/env ruby
# frozen_string_literal: true

# The consolidated Partitura CLI. See docs/architecture/partitura/08_cli_and_guided_runs.md.
#   discover   commands | catalog
#   compose    start | status | commit | next | back | log | abandon | runs
#   author     compile | lint | view | help
#   library    cards
#   output     export | build

require "json"
require "optparse"
require "fileutils"
require_relative "../lib/partitura/diagnostic"

BIN_DIR = __dir__
LIBRARY_ROOT = File.expand_path("../..", __dir__)

def require_partitura
  require_relative "../lib/partitura"
end

def usage
  <<~TEXT
    usage: partitura <command> [args]

      discover   commands [COMMAND] [--json]
                 catalog [commands|views|procedures|annotation-profiles|examples]
                         [ITEM] [--json]
                 protocol template proposal-response PROPOSAL_REQUEST.json --producer ID
                          [--patch DIFF] [--description TEXT] [--candidate-id ID]
                 protocol template selection-response SELECTION_REQUEST.json --producer ID
                          [--select original|ID] [--reason TEXT]
                 protocol validate MESSAGE.json [--against REQUEST.json]
      compose    start <dir> [--procedure ID] [--source FILE] [--brief TEXT]
                           [--miniature] [--force-new]
                 status [<dir>]
                 commit [<dir>] [--span A-B | --unit LABEL] [--stage-complete] --notes FILE|-
                 next [<dir>] --reason TEXT        (skip; logged as skipped_audit)
                 back [<dir>] --to sN --reason TEXT
                 log [<dir>] [--json]
                 abandon [<dir>] --reason TEXT
                 runs [<root>]
                 observe SOURCE --trajectory FILE
                 evaluate SOURCE --trajectory FILE --proposals FILE|-
                 step SOURCE --trajectory FILE --proposals FILE [--selection FILE]
                 review --trajectory FILE --reviews FILE --output DIR
                        --transition ID --candidate ID --against original|ID
                        --scale SCALE --criterion CRITERION
                 preference --reviews FILE --preferences FILE --review ID
                            --outcome a|b|tie|abstain --rater ID
                            --purpose LABEL --reason TEXT
      evaluate   benchmark-score SOURCE
                 score-observation MUSICXML|MXL
                 annotation-observation SCORE_OBSERVATION.json --profile PROFILE
                                        --annotation KIND=FILE [--annotation KIND=FILE ...]
                 benchmark-review LEFT_SOURCE RIGHT_SOURCE --left-run ID --right-run ID
                                  --benchmark ID --case ID --criterion CRITERION
                                  --reviews FILE --output DIR
                 benchmark-preference --reviews FILE --preferences FILE --review ID
                                      --outcome a|b|tie|abstain --rater ID --reason TEXT
      author     compile SOURCE
                 lint SOURCE
                 view SOURCE [view] [--part ID] [--bars A-B] [--json]
                 help [topic] [--json]
                 import-musicxml SCORE.musicxml [--bars A-B] [--segments SPEC]
                                 [--beats N] [--perc-map FROM=TO] [--json]
                 verify-musicxml-import HAND.musicxml EXPORT.musicxml [--bars A-B]
                                        [--beats N] [--perc-map FROM=TO] [--json]
      library    cards <query terms> | cards show <ID> | cards terms
      output     export SOURCE [--stem STEM]
                 build REGISTRY.rb [movement|all]

    Start here: `partitura help index`.
    Compose end-to-end: `partitura start <dir> --source SOURCE.rb --brief "commission"`.
  TEXT
end

def emit_error(response, exit_code: 1)
  warn JSON.pretty_generate(response)
  exit exit_code
end

def structured_failure(code, message, repair, help_topic: "production", extra: {})
  emit_error(Partitura::Diagnostic.envelope({
    status: "error", code: code, message: message, repair_instruction: repair,
    help_topic: help_topic, docs: ["docs/architecture/partitura/08_cli_and_guided_runs.md"]
  }.merge(extra)))
end

def source_failure(error, source: nil, help_topic: "production")
  syntax = error.is_a?(SyntaxError)
  structured_failure(
    syntax ? "invalid_ruby_source" : "unreadable_source",
    error.message,
    syntax ? "Correct the Ruby syntax in the Partitura source and rerun the command." :
             "Pass a readable Partitura Ruby source file and rerun the command.",
    help_topic: help_topic,
    extra: source ? { source_file: source } : {}
  )
end

def guided_guard
  require_partitura
  yield
rescue Partitura::Guided::GateFailure => e
  failures = e.results.reject(&:ok)
  structured_failure("gate_failed", e.message,
                     "Resolve each failed gate, then rerun the same commit: " \
                     "#{failures.map { |r| "#{r.gate}: #{r.detail}" }.join('; ')}",
                     extra: { gates: e.results.map(&:to_h) })
rescue Partitura::Guided::PassNoteError => e
  structured_failure("pass_note_incomplete", e.message,
                     "Write the pass note as `field: value` lines and rerun the commit.")
rescue Partitura::Guided::RunError, Partitura::Guided::ManifestError => e
  structured_failure("run_error", e.message, "Follow the message; `partitura status` shows the current stage.")
end

def workflow_guard
  require_partitura
  yield
rescue Partitura::Production::CompositionWorkflow::Error => e
  emit_error(e.to_h)
rescue Partitura::Production::CompileError => e
  emit_error(e.response)
rescue Errno::ENOENT, Errno::EACCES, SyntaxError => e
  source_failure(e)
end

def evaluation_guard
  require_partitura
  yield
rescue Partitura::Production::Evaluation::Error => e
  emit_error(e.to_h)
rescue Errno::ENOENT, Errno::EACCES, SyntaxError => e
  source_failure(e, help_topic: "evaluation")
end

def score_observation_guard
  require_partitura
  yield
rescue Partitura::ScoreObservation::Error => e
  emit_error(e.to_h)
end

def annotation_observation_guard
  require_partitura
  yield
rescue Partitura::AnnotationObservation::Error => e
  emit_error(e.to_h)
end

def annotation_observation_options(argv)
  options = { profile: nil, annotations: [] }
  OptionParser.new do |opts|
    opts.on("--profile PROFILE") { |value| options[:profile] = value }
    opts.on("--annotation KIND=FILE") do |value|
      kind, path = value.split("=", 2)
      unless kind && path && !kind.empty? && !path.empty?
        raise OptionParser::InvalidArgument, "--annotation must be KIND=FILE"
      end
      options[:annotations] << { kind:, path: }
    end
  end.parse!(argv)
  options
end

def workflow_options(argv, selection: false)
  options = {
    trajectory: nil, proposals: nil, selection: nil, export: true,
    trajectory_origin: nil, trajectory_quality: nil, run_id: nil
  }
  OptionParser.new do |opts|
    opts.on("--trajectory FILE") { |value| options[:trajectory] = value }
    opts.on("--proposals FILE") { |value| options[:proposals] = value }
    opts.on("--selection FILE") { |value| options[:selection] = value } if selection
    opts.on("--trajectory-origin ORIGIN") { |value| options[:trajectory_origin] = value }
    opts.on("--trajectory-quality QUALITY") { |value| options[:trajectory_quality] = value }
    opts.on("--run-id ID") { |value| options[:run_id] = value }
    opts.on("--no-export") { options[:export] = false }
  end.parse!(argv)
  options
end

def workflow_loop(options)
  workflow = Partitura::Production::CompositionWorkflow
  context_options = [
    options[:trajectory_origin], options[:trajectory_quality], options[:run_id]
  ]
  context = if context_options.any?
              origin = options[:trajectory_origin] || "deterministic"
              quality = options[:trajectory_quality] || (origin == "agent" ? "medium" : "unrated")
              path_digest = Digest::SHA256.hexdigest(File.expand_path(options.fetch(:trajectory)))
              workflow::TrajectoryContext.new(
                run_id: options[:run_id] || "run:#{path_digest[0, 20]}",
                origin: origin,
                quality_label: quality
              )
            end
  store = workflow::TrajectoryStore.new(options.fetch(:trajectory), context: context)
  workflow::CompositionLoop.new(
    trajectory_store: store,
    export_candidates: options.fetch(:export)
  )
end

def require_workflow_option(options, key, command)
  return options.fetch(key) if options[key]

  raise Partitura::Production::CompositionWorkflow::Error.new(
    "missing_option", "#{command} requires --#{key.to_s.tr('_', '-')} FILE"
  )
end

def review_options(argv)
  options = {
    trajectory: nil, reviews: nil, output: nil, transition: nil,
    candidate: nil, against: nil, scale: nil, criterion: nil, seed: "default"
  }
  OptionParser.new do |opts|
    opts.on("--trajectory FILE") { |value| options[:trajectory] = value }
    opts.on("--reviews FILE") { |value| options[:reviews] = value }
    opts.on("--output DIR") { |value| options[:output] = value }
    opts.on("--transition ID") { |value| options[:transition] = value }
    opts.on("--candidate ID") { |value| options[:candidate] = value }
    opts.on("--against ID") { |value| options[:against] = value }
    opts.on("--scale SCALE") { |value| options[:scale] = value }
    opts.on("--criterion CRITERION") { |value| options[:criterion] = value }
    opts.on("--seed TEXT") { |value| options[:seed] = value }
  end.parse!(argv)
  options
end

def preference_options(argv)
  options = {
    reviews: nil, preferences: nil, review: nil, outcome: nil,
    rater: nil, purpose: nil, reason: nil, confidence: nil
  }
  OptionParser.new do |opts|
    opts.on("--reviews FILE") { |value| options[:reviews] = value }
    opts.on("--preferences FILE") { |value| options[:preferences] = value }
    opts.on("--review ID") { |value| options[:review] = value }
    opts.on("--outcome OUTCOME") { |value| options[:outcome] = value }
    opts.on("--rater ID") { |value| options[:rater] = value }
    opts.on("--purpose PURPOSE") { |value| options[:purpose] = value }
    opts.on("--reason TEXT") { |value| options[:reason] = value }
    opts.on("--confidence NUMBER", Float) { |value| options[:confidence] = value }
  end.parse!(argv)
  options
end

def require_options(options, keys, command)
  keys.each_with_object({}) do |key, required|
    value = options[key]
    unless value
      raise Partitura::Production::CompositionWorkflow::Error.new(
        "missing_option", "#{command} requires --#{key.to_s.tr('_', '-')}"
      )
    end
    required[key] = value
  end
end

def benchmark_review_options(argv)
  options = {
    left_run: nil, right_run: nil, benchmark: nil, case: nil,
    criterion: nil, reviews: nil, output: nil, seed: "default"
  }
  OptionParser.new do |opts|
    opts.on("--left-run ID") { |value| options[:left_run] = value }
    opts.on("--right-run ID") { |value| options[:right_run] = value }
    opts.on("--benchmark ID") { |value| options[:benchmark] = value }
    opts.on("--case ID") { |value| options[:case] = value }
    opts.on("--criterion CRITERION") { |value| options[:criterion] = value }
    opts.on("--reviews FILE") { |value| options[:reviews] = value }
    opts.on("--output DIR") { |value| options[:output] = value }
    opts.on("--seed TEXT") { |value| options[:seed] = value }
  end.parse!(argv)
  options
end

def benchmark_preference_options(argv)
  options = {
    reviews: nil, preferences: nil, review: nil, outcome: nil,
    rater: nil, reason: nil, confidence: nil
  }
  OptionParser.new do |opts|
    opts.on("--reviews FILE") { |value| options[:reviews] = value }
    opts.on("--preferences FILE") { |value| options[:preferences] = value }
    opts.on("--review ID") { |value| options[:review] = value }
    opts.on("--outcome OUTCOME") { |value| options[:outcome] = value }
    opts.on("--rater ID") { |value| options[:rater] = value }
    opts.on("--reason TEXT") { |value| options[:reason] = value }
    opts.on("--confidence NUMBER", Float) { |value| options[:confidence] = value }
  end.parse!(argv)
  options
end

def read_notes(path)
  return $stdin.read.force_encoding(Encoding::UTF_8).scrub if path == "-"

  structured_failure("missing_notes", "commit requires --notes FILE|-",
                     "Pass the pass note file, or `-` to read it from stdin.") unless path && File.exist?(path)
  File.read(path, encoding: Encoding::UTF_8).scrub
end

def protocol_tool_options(argv)
  options = {
    producer: nil, patch: nil, description: nil, candidate_id: nil,
    select: nil, reason: nil, against: nil
  }
  OptionParser.new do |opts|
    opts.on("--producer ID") { |value| options[:producer] = value }
    opts.on("--patch FILE") { |value| options[:patch] = value }
    opts.on("--description TEXT") { |value| options[:description] = value }
    opts.on("--candidate-id ID") { |value| options[:candidate_id] = value }
    opts.on("--select ID") { |value| options[:select] = value }
    opts.on("--reason TEXT") { |value| options[:reason] = value }
    opts.on("--against FILE") { |value| options[:against] = value }
  end.parse!(argv)
  options
end

def read_protocol_patch(path)
  return unless path

  path == "-" ? $stdin.read : File.read(path, encoding: Encoding::UTF_8)
rescue Errno::ENOENT, Errno::EACCES => error
  raise Partitura::Production::CompositionWorkflow::Error.new(
    "unreadable_protocol_patch", error.message
  )
end

def musicxml_import_options(argv, segments: false)
  options = { bars: 1..10_000, beats: 2, perc_map: {}, json: false, segments: nil }
  OptionParser.new do |opts|
    opts.on("--bars A-B") { |value| options[:bars] = positive_bar_range(value, "--bars") }
    if segments
      opts.on("--segments SPEC") { |value| options[:segments] = segment_spec(value) }
    end
    opts.on("--beats N") do |value|
      beats = Rational(value)
      raise OptionParser::InvalidArgument, "--beats must be positive" unless beats.positive?

      options[:beats] = beats
    end
    opts.on("--perc-map FROM=TO") { |value| add_percussion_mapping(options[:perc_map], value) }
    opts.on("--json") { options[:json] = true }
  end.parse!(argv)
  options
end

def positive_bar_range(value, label)
  match = /\A(\d+)-(\d+)\z/.match(value)
  raise OptionParser::InvalidArgument, "#{label} must be A-B" unless match

  first = Integer(match[1])
  last = Integer(match[2])
  unless first.positive? && last >= first
    raise OptionParser::InvalidArgument, "#{label} must be an ascending positive range"
  end
  first..last
end

def segment_spec(value)
  value.split(",").each do |item|
    name, range = item.split(":", 2)
    unless name && range && !name.empty?
      raise OptionParser::InvalidArgument, "--segments must be NAME:A-B[,NAME:A-B]"
    end
    positive_bar_range(range, "segment #{name}")
  end
  value
end

def add_percussion_mapping(mappings, value)
  from, to = value.split("=", 2)
  unless from && to && !from.empty? && !to.empty?
    raise OptionParser::InvalidArgument, "--perc-map must be FROM=TO"
  end
  mappings[from] = to
end

def musicxml_import_guard
  require_partitura
  yield
rescue REXML::ParseException, Errno::ENOENT, Errno::EACCES, OptionParser::ParseError,
       ArgumentError, KeyError => error
  structured_failure(
    "musicxml_import_error", error.message,
    "Check the MusicXML paths and focused import options, then rerun the same command.",
    help_topic: "hand_edit_import"
  )
end

def optional_dir(argv)
  argv.first && !argv.first.start_with?("-") ? argv.shift : nil
end

command = ARGV.shift
case command
when nil, "-h", "--help"
  puts usage

when "commands"
  require_relative "../lib/partitura/catalog"
  json = ARGV.delete("--json")
  item = ARGV.shift
  begin
    payload = Partitura::Catalog.data("commands", item)
    puts(json ? JSON.pretty_generate(payload) : Partitura::Catalog.render("commands", item))
  rescue KeyError => e
    structured_failure("unknown_command", e.message, "Run `partitura commands --json` to list commands.",
                       help_topic: "index")
  end

when "catalog"
  json = ARGV.delete("--json")
  name = ARGV.shift
  item = ARGV.shift
  normalized = name&.tr("-", "_")
  require_partitura unless [nil, "commands", "examples"].include?(normalized)
  require_relative "../lib/partitura/catalog"
  begin
    payload = Partitura::Catalog.data(name, item)
    puts(json ? JSON.pretty_generate(payload) : Partitura::Catalog.render(name, item))
  rescue KeyError => e
    structured_failure("unknown_catalog_item", e.message,
                       "Run `partitura catalog --json` to list catalogues.", help_topic: "index")
  end

when "protocol"
  workflow_guard do
    options = protocol_tool_options(ARGV)
    action = ARGV.shift
    workflow = Partitura::Production::CompositionWorkflow
    case action
    when "template"
      kind = ARGV.shift
      request_path = ARGV.shift
      unless kind && request_path && options[:producer]
        raise workflow::Error.new(
          "missing_protocol_template_input",
          "protocol template requires KIND REQUEST.json --producer ID"
        )
      end
      request = workflow::Protocol.read_json(request_path)
      payload = workflow::ProtocolTools.template(
        kind,
        request,
        producer: options.fetch(:producer),
        patch: read_protocol_patch(options[:patch]),
        description: options[:description],
        candidate_id: options[:candidate_id],
        selected_candidate_id: options[:select],
        reason: options[:reason]
      )
      puts JSON.pretty_generate(payload)
    when "validate"
      message_path = ARGV.shift
      unless message_path
        raise workflow::Error.new(
          "missing_protocol_message", "protocol validate requires MESSAGE.json"
        )
      end
      message = workflow::Protocol.read_json(message_path)
      against = options[:against] && workflow::Protocol.read_json(options.fetch(:against))
      puts JSON.pretty_generate(workflow::ProtocolTools.validate(message, against_data: against))
    else
      raise workflow::Error.new(
        "unknown_protocol_action", "protocol action must be template or validate"
      )
    end
  end

when "import-musicxml"
  musicxml_import_guard do
    options = musicxml_import_options(ARGV, segments: true)
    source = ARGV.shift
    unless source
      structured_failure(
        "missing_musicxml", "import-musicxml requires SCORE.musicxml",
        "Pass the authoritative hand-edited MusicXML path.", help_topic: "hand_edit_import"
      )
    end
    conversion = Partitura.production_musicxml_import(
      source,
      bars: options.fetch(:bars),
      segments: options[:segments],
      beats: options.fetch(:beats),
      perc_map: options.fetch(:perc_map)
    )
    payload = conversion.json_h
    puts(options[:json] ? JSON.pretty_generate(payload) : conversion.render)
  end

when "verify-musicxml-import"
  musicxml_import_guard do
    options = musicxml_import_options(ARGV)
    hand_path = ARGV.shift
    export_path = ARGV.shift
    unless hand_path && export_path
      structured_failure(
        "missing_musicxml", "verify-musicxml-import requires HAND.musicxml EXPORT.musicxml",
        "Pass both the authoritative hand file and the current Partitura export.",
        help_topic: "hand_edit_import"
      )
    end
    verification = Partitura.production_musicxml_import_verify(
      hand_path,
      export_path,
      bars: options.fetch(:bars),
      beats: options.fetch(:beats),
      perc_map: options.fetch(:perc_map)
    )
    payload = verification.json_h
    puts(options[:json] ? JSON.pretty_generate(payload) : verification.render)
    exit 1 unless verification.ok?
  end

when "help"
  require_relative "../lib/partitura/jit_docs"
  json = ARGV.delete("--json")
  topic = (ARGV.shift || "index").to_sym
  puts(json ? Partitura::JITDocs.render_json(topic) : Partitura::JITDocs.render(topic))

when "view"
  require_partitura
  options = { json: false }
  parser = OptionParser.new do |opts|
    opts.on("--part PART") { |value| options[:part] = value.to_sym }
    opts.on("--bars RANGE") { |value| options[:bars] = value }
    opts.on("--json") { options[:json] = true }
  end
  parser.parse!
  source = ARGV.shift
  view = (ARGV.shift || "structure").to_sym
  unless source
    require_relative "../lib/partitura/catalog"
    payload = Partitura::Catalog.data("views")
    puts(options[:json] ? JSON.pretty_generate(payload) : Partitura::Catalog.render("views"))
    exit 0
  end
  begin
    puts Partitura.production_readout(Partitura.load_production_file(source), view, **options)
  rescue Partitura::Production::CompileError => e
    if view == :compile
      puts JSON.pretty_generate(e.response)
      exit 0
    end
    emit_error(e.response)
  rescue Errno::ENOENT, Errno::EACCES, SyntaxError => e
    source_failure(e, source: source)
  end

when "observe"
  workflow_guard do
    options = workflow_options(ARGV)
    source = ARGV.shift or (warn "usage: partitura observe SOURCE.rb --trajectory FILE"; exit 2)
    require_workflow_option(options, :trajectory, "observe")
    loop = workflow_loop(options)
    state = loop.load_state(source_path: source)
    observation = loop.observe(state, source_path: source)
    payload = observation.proposal_request&.to_h || observation.to_h
    puts JSON.pretty_generate(payload)
  end

when "evaluate"
  workflow_guard do
    options = workflow_options(ARGV)
    source = ARGV.shift or (
      warn "usage: partitura evaluate SOURCE.rb --trajectory FILE --proposals FILE|-"
      exit 2
    )
    require_workflow_option(options, :trajectory, "evaluate")
    proposals_path = require_workflow_option(options, :proposals, "evaluate")
    workflow = Partitura::Production::CompositionWorkflow
    loop = workflow_loop(options)
    state = loop.load_state(source_path: source)
    observation = loop.observe(state, source_path: source)
    unless observation.proposal_request
      puts JSON.pretty_generate(observation.to_h)
      next
    end
    response = workflow::ProposalResponse.from_h(
      workflow::Protocol.read_json(proposals_path)
    )
    evaluation = loop.evaluate(
      state,
      source_path: source,
      proposal_request: observation.proposal_request,
      proposal_response: response
    )
    payload = evaluation.selection_request&.to_h || {
      status: "deferred",
      proposal_request_id: observation.proposal_request.request_id,
      candidate_count: 0
    }
    puts JSON.pretty_generate(payload)
  end

when "step"
  workflow_guard do
    options = workflow_options(ARGV, selection: true)
    source = ARGV.shift or (
      warn "usage: partitura step SOURCE.rb --trajectory FILE --proposals FILE [--selection FILE]"
      exit 2
    )
    require_workflow_option(options, :trajectory, "step")
    proposals_path = require_workflow_option(options, :proposals, "step")
    workflow = Partitura::Production::CompositionWorkflow
    loop = workflow_loop(options)
    state = loop.load_state(source_path: source)
    observation = loop.observe(state, source_path: source)
    unless observation.proposal_request
      puts JSON.pretty_generate(observation.to_h)
      next
    end
    proposal = workflow::ProposalResponse.from_h(
      workflow::Protocol.read_json(proposals_path)
    )
    evaluation = loop.evaluate(
      state,
      source_path: source,
      proposal_request: observation.proposal_request,
      proposal_response: proposal
    )
    selection = if evaluation.selection_request
                  selection_path = require_workflow_option(options, :selection, "step")
                  workflow::SelectionResponse.from_h(
                    workflow::Protocol.read_json(selection_path)
                  )
                end
    result = loop.commit(
      state,
      source_path: source,
      evaluation: evaluation,
      selection_response: selection
    )
    puts JSON.pretty_generate(result.to_h)
  end

when "review"
  workflow_guard do
    options = review_options(ARGV)
    required = require_options(
      options,
      %i[trajectory reviews output transition candidate against scale criterion],
      "review"
    )
    workflow = Partitura::Production::CompositionWorkflow
    transition = workflow::TrajectoryStore.new(required.fetch(:trajectory))
                                              .load
                                              .find do |item|
      item.transition_id == required.fetch(:transition)
    end
    unless transition
      raise workflow::Error.new(
        "unknown_transition", "#{required.fetch(:transition)} is absent from the trajectory"
      )
    end
    bundle = workflow::PairwiseReviewBuilder.new.build(
      transition: transition,
      candidate_id: required.fetch(:candidate),
      against_id: required.fetch(:against),
      scale: required.fetch(:scale),
      criterion: required.fetch(:criterion),
      seed: options.fetch(:seed)
    )
    review_store = workflow::ReviewStore.new(required.fetch(:reviews))
    if review_store.load.any? { |item| item.review_id == bundle.review.review_id }
      raise workflow::Error.new(
        "duplicate_review", "#{bundle.review.review_id} is already stored"
      )
    end
    bundle_path = bundle.write(required.fetch(:output))
    review_store.append(bundle.review)
    puts JSON.pretty_generate(bundle.review.public_h.merge(bundle: bundle_path))
  end

when "preference"
  workflow_guard do
    options = preference_options(ARGV)
    required = require_options(
      options,
      %i[reviews preferences review outcome rater purpose reason],
      "preference"
    )
    workflow = Partitura::Production::CompositionWorkflow
    review = workflow::ReviewStore.new(required.fetch(:reviews))
                                    .fetch(required.fetch(:review))
    preference = workflow::PreferenceRecord.create(
      review: review,
      outcome: required.fetch(:outcome),
      rater_id: required.fetch(:rater),
      purpose: required.fetch(:purpose),
      reason: required.fetch(:reason),
      confidence: options[:confidence]
    )
    workflow::PreferenceStore.new(required.fetch(:preferences)).append(preference)
    puts JSON.pretty_generate(preference.to_h)
  end

when "benchmark-score"
  evaluation_guard do
    source = ARGV.shift or (
      warn "usage: partitura benchmark-score SOURCE.rb"
      exit 2
    )
    profile = Partitura::Production::Evaluation::ScoreMeasurement.from_source(source)
    puts JSON.pretty_generate(profile)
  end

when "score-observation"
  score_observation_guard do
    source = ARGV.shift or (
      warn "usage: partitura score-observation SCORE.musicxml|SCORE.mxl"
      exit 2
    )
    puts JSON.pretty_generate(Partitura.score_observation(source))
  end

when "annotation-observation"
  annotation_observation_guard do
    options = annotation_observation_options(ARGV)
    observation = ARGV.shift
    unless observation && options[:profile] && options[:annotations].any?
      warn "usage: partitura annotation-observation SCORE_OBSERVATION.json " \
           "--profile PROFILE --annotation KIND=FILE [...]"
      exit 2
    end
    puts JSON.pretty_generate(
      Partitura.annotation_observation(
        observation,
        profile: options.fetch(:profile),
        annotations: options.fetch(:annotations)
      )
    )
  end

when "benchmark-review"
  evaluation_guard do
    options = benchmark_review_options(ARGV)
    left_source = ARGV.shift
    right_source = ARGV.shift
    unless left_source && right_source
      warn "usage: partitura benchmark-review LEFT.rb RIGHT.rb [options]"
      exit 2
    end
    required = require_options(
      options,
      %i[left_run right_run benchmark case criterion reviews output],
      "benchmark-review"
    )
    evaluation = Partitura::Production::Evaluation
    bundle = evaluation::ScoreReviewBuilder.new.build(
      benchmark_id: required.fetch(:benchmark),
      case_id: required.fetch(:case),
      criterion: required.fetch(:criterion),
      left_run_id: required.fetch(:left_run),
      left_source: left_source,
      right_run_id: required.fetch(:right_run),
      right_source: right_source,
      seed: options.fetch(:seed)
    )
    store = evaluation::ScoreReviewStore.new(required.fetch(:reviews))
    if store.load.any? { |item| item.review_id == bundle.review.review_id }
      raise evaluation::Error.new(
        "duplicate_evaluation_review", "#{bundle.review.review_id} is already stored"
      )
    end
    bundle_path = bundle.write(required.fetch(:output))
    store.append(bundle.review)
    puts JSON.pretty_generate(bundle.review.public_h.merge(bundle: bundle_path))
  end

when "benchmark-preference"
  evaluation_guard do
    options = benchmark_preference_options(ARGV)
    required = require_options(
      options,
      %i[reviews preferences review outcome rater reason],
      "benchmark-preference"
    )
    evaluation = Partitura::Production::Evaluation
    review = evaluation::ScoreReviewStore.new(required.fetch(:reviews))
                                             .fetch(required.fetch(:review))
    preference = evaluation::ScorePreference.create(
      review: review,
      outcome: required.fetch(:outcome),
      rater_id: required.fetch(:rater),
      reason: required.fetch(:reason),
      confidence: options[:confidence]
    )
    evaluation::ScorePreferenceStore.new(required.fetch(:preferences)).append(preference)
    puts JSON.pretty_generate(preference.to_h)
  end

when "compile", "lint"
  require_partitura
  source = ARGV.shift or (warn "usage: partitura #{command} SOURCE.rb"; exit 2)
  begin
    piece = Partitura.load_production_file(source)
    if command == "compile"
      response = piece.compile_response
      puts JSON.pretty_generate(response)
      exit(response[:status] == "ok" ? 0 : 1)
    else
      puts Partitura::Production::Lint.render(piece)
    end
  rescue Partitura::Production::CompileError => e
    command == "compile" ? (puts JSON.pretty_generate(e.response); exit 1) : emit_error(e.response)
  rescue Errno::ENOENT, Errno::EACCES, SyntaxError => e
    source_failure(e, source: source)
  end

when "export"
  require_partitura
  options = { stem: nil }
  OptionParser.new { |opts| opts.on("--stem STEM") { |value| options[:stem] = value } }.parse!
  source = ARGV.shift or (warn "usage: partitura export SOURCE.rb [--stem STEM]"; exit 2)
  stem = options[:stem] || File.basename(source, File.extname(source))
  repo_root = `git -C #{File.dirname(File.expand_path(source))} rev-parse --show-toplevel 2>/dev/null`.chomp
  repo_root = File.dirname(File.expand_path(source)) if repo_root.empty?
  source_rel = File.expand_path(source).delete_prefix("#{repo_root}/")
  out_dir = File.join(repo_root, "outputs", File.dirname(source_rel), stem)
  FileUtils.mkdir_p(out_dir)
  begin
    piece = Partitura.load_production_file(source)
    piece.validate!
    File.write(File.join(out_dir, "#{stem}.musicxml"), Partitura.production_musicxml(piece))
    File.binwrite(File.join(out_dir, "#{stem}.mid"), Partitura.production_midi(piece))
  rescue Partitura::Production::CompileError => e
    emit_error(e.response)
  rescue Errno::ENOENT, Errno::EACCES, SyntaxError => e
    source_failure(e, source: source)
  end
  puts JSON.pretty_generate(
    musicxml: File.join(out_dir, "#{stem}.musicxml"),
    midi: File.join(out_dir, "#{stem}.mid")
  )

when "build"
  require_relative "../lib/partitura/framework"
  registry_path = ARGV.shift or (warn "usage: partitura build REGISTRY.rb [movement|all]"; exit 2)
  movement = ARGV.shift || "all"
  begin
    registry = Partitura::Framework::Registry.load_file(registry_path)
    puts JSON.pretty_generate(exports: registry.export(movement))
  rescue Partitura::Production::CompileError => e
    emit_error(e.response)
  rescue Errno::ENOENT, Errno::EACCES, SyntaxError => e
    source_failure(e, source: registry_path)
  end

when "cards"
  exec RbConfig.ruby, File.join(LIBRARY_ROOT, "tools", "lib.rb"), *ARGV

when "start"
  guided_guard do
    options = { procedure: "dsl_composition", source: nil, miniature: false, force_new: false, brief: nil }
    OptionParser.new do |opts|
      opts.on("--procedure ID") { |value| options[:procedure] = value }
      opts.on("--source FILE") { |value| options[:source] = value }
      opts.on("--miniature") { options[:miniature] = true }
      opts.on("--force-new") { options[:force_new] = true }
      opts.on("--brief TEXT") { |value| options[:brief] = value }
    end.parse!
    dir = ARGV.shift or (warn 'usage: partitura start <dir> --brief "commission" [--procedure ID] ' \
                              "[--source FILE] [--miniature]"; exit 2)
    _run, payload = Partitura::Guided.start(dir, **options)
    puts payload
  end

when "status"
  guided_guard do
    json = ARGV.delete("--json")
    dir = optional_dir(ARGV)
    run, payload = Partitura::Guided.status(dir)
    puts(json ? JSON.pretty_generate(Partitura::Guided::Payload.data(run)) : payload)
  end

when "commit"
  guided_guard do
    options = { notes: nil, unit: nil, stage_complete: false, source: nil }
    OptionParser.new do |opts|
      opts.on("--notes PATH") { |value| options[:notes] = value }
      opts.on("--span RANGE") { |value| options[:unit] = "bars #{value}" }
      opts.on("--unit LABEL") { |value| options[:unit] = value }
      opts.on("--stage-complete") { options[:stage_complete] = true }
      opts.on("--source FILE") { |value| options[:source] = value }
    end.parse!
    dir = optional_dir(ARGV)
    notes = read_notes(options[:notes])
    _run, payload = Partitura::Guided.commit(dir: dir, notes: notes, unit: options[:unit],
                                             stage_complete: options[:stage_complete], source: options[:source])
    puts payload
  end

when "next"
  guided_guard do
    reason = nil
    OptionParser.new { |opts| opts.on("--reason TEXT") { |value| reason = value } }.parse!
    _run, payload = Partitura::Guided.skip(dir: optional_dir(ARGV), reason: reason)
    puts "WARNING: stage skipped without audit; logged as skipped_audit (blocks closeout until resolved)."
    puts
    puts payload
  end

when "back"
  guided_guard do
    options = { to: nil, reason: nil }
    OptionParser.new do |opts|
      opts.on("--to STAGE") { |value| options[:to] = value }
      opts.on("--reason TEXT") { |value| options[:reason] = value }
    end.parse!
    structured_failure("missing_option", "back requires --to sN", "Name the stage to reopen.") unless options[:to]
    _run, payload = Partitura::Guided.back(dir: optional_dir(ARGV), to: options[:to], reason: options[:reason])
    puts payload
  end

when "log"
  guided_guard do
    json = ARGV.delete("--json")
    run = Partitura::Guided::Run.locate(optional_dir(ARGV))
    entries = run.log_entries
    if json
      puts JSON.pretty_generate(entries)
    else
      entries.each do |entry|
        detail = entry.reject { |key, _| %w[ts event pass_note gates].include?(key) }
        verdict = entry.dig("pass_note", "musical_verdict") || entry.dig("pass_note", "verdict")
        note = verdict && " musical_verdict=#{verdict.to_s.lines.first&.strip}"
        puts "#{entry['ts']}  #{entry['event']}  #{detail.map { |k, v| "#{k}=#{v}" }.join(' ')}#{note}"
      end
    end
  end

when "abandon"
  guided_guard do
    reason = nil
    OptionParser.new { |opts| opts.on("--reason TEXT") { |value| reason = value } }.parse!
    run = Partitura::Guided.abandon(dir: optional_dir(ARGV), reason: reason)
    puts "run abandoned: #{run.dir}"
  end

when "runs"
  guided_guard do
    root = ARGV.shift || ENV["PARTITURA_PROJECT_ROOT"] || Dir.pwd
    runs = Partitura::Guided.runs(root)
    if runs.empty?
      puts "no runs under #{root}"
    else
      runs.each do |run|
        state = run.closed? ? run.state.dig("closed", "kind") : "stage #{run.current_stage_id}"
        puts "#{run.dir}  #{run.manifest.id} v#{run.manifest.version} (#{run.mode})  #{state}"
      end
    end
  end

else
  warn "unknown command #{command.inspect}"
  warn ""
  warn usage
  exit 2
end
